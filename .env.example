# --- Database -------------------------------------------------------------
# MongoDB connection string (local instance by default)
MONGODB_URI=mongodb://127.0.0.1:27017/campusflow

# --- Auth -----------------------------------------------------------------
# Secret used to sign JWT session cookies (openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-string
# e.g. 7d, 30d, 12h
JWT_EXPIRES_IN=7d

# --- Payments (Paystack) --------------------------------------------------
# Leave PAYSTACK_SECRET_KEY empty to run the simulated checkout in local dev.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
